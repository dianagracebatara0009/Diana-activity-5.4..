package helloworld.array;

public class GradeExam {
    public static void main(String[] args) {

        char[][] answers = {
            {'A', 'B', 'A', 'C', 'C', 'D', 'E', 'E', 'A', 'D'},
            {'D', 'B', 'A', 'B', 'C', 'A', 'E', 'E', 'A', 'D'},
            {'E', 'D', 'D', 'A', 'C', 'B', 'E', 'E', 'A', 'D'},
            {'C', 'B', 'A', 'E', 'D', 'C', 'E', 'E', 'A', 'D'}
        };

        char[] keys = {
            'D', 'B', 'D', 'C', 'C', 'D', 'A', 'E', 'A', 'D'
        };

        int i = 0;

        do {
            int correctCount = 0;
            int j = 0;

            do {
                if (answers[i][j] == keys[j]) {
                    correctCount++;
                }
                j++;
            } while (j < answers[i].length);

            System.out.println("Student " + i
                    + "'s correct count is " + correctCount);

            i++;
        } while (i < answers.length);
    }
}